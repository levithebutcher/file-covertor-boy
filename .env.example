# ==============================================================================
# TELEGRAM BOT CONFIGURATION (CREDENTIALS)
# ==============================================================================
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Get API_ID and API_HASH from https://my.telegram.org (under API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Telegram User ID of the primary bot owner (numeric ID, get via @userinfobot)
OWNER_ID=123456789

# Optional: Comma-separated list of additional admin IDs
ADMIN_IDS=123456789,987654321

# ==============================================================================
# HOSTING & CONCURRENCY CONFIGURATION
# ==============================================================================
# HTTP Port for Render web service health checks
PORT=10000

# Maximum concurrent background jobs (Default: 1 for Render Free 512MB RAM)
MAX_CONCURRENT_JOBS=1

# ==============================================================================
# TELEGRAM BOT CONFIGURATION (CREDENTIALS)
# ==============================================================================
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Get API_ID and API_HASH from https://my.telegram.org (under API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Telegram User ID of the primary bot owner (numeric ID, get via @userinfobot)
OWNER_ID=123456789

# Optional: Comma-separated list of additional admin IDs
ADMIN_IDS=123456789,987654321

# ==============================================================================
# SHARED DATABASE (MONGODB ATLAS FREE TIER)
# ==============================================================================
# Connection string from MongoDB Atlas (Database -> Connect -> Drivers)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=media_converter_bot

# ==============================================================================
# HOSTING & HANDOFF CONFIGURATION
# ==============================================================================
# Host mode: 'render' (primary lightweight service), 'colab' (worker node), or 'auto'
HOST_MODE=auto

# Maximum file size (in Megabytes) processed directly on Render Free (512MB RAM)
# Files exceeding this threshold are queued for Google Colab processing.
BIG_FILE_THRESHOLD_MB=100

# HTTP Port for Render web service health checks
PORT=10000

# GitHub repository URL (used by Colab notebook generator to clone code)
REPO_URL=https://github.com/your-username/your-repo.git

# Optional: Concurrency limit for video encoding/zipping on this node (Default: 1 for Render Free)
MAX_CONCURRENT_JOBS=1
